{
  "id": "web_recon_httpx",
  "name": "Web Recon: Live Host & Tech Detection (httpx)",
  "description": "Uses httpx to quickly identify live web servers from a list of URLs and performs basic technology detection.",
  "tags": [
    "web",
    "recon",
    "httpx",
    "osint"
  ],
  "steps": [
    {
      "id": "step1_live_probe",
      "name": "Live Host Probe",
      "description": "Run httpx against the target to check for live web servers.",
      "toolId": "httpx",
      "argsTemplate": [
        "-u",
        "<target>",
        "-silent",
        "-json"
      ],
      "ruleIds": [
        "httpx_live_url"
      ],
      "payload_id": "httpx"
    },
    {
      "id": "step2_tech_detect",
      "name": "Technology Detection",
      "description": "Run httpx with technology detection enabled to identify web technologies.",
      "toolId": "httpx",
      "argsTemplate": [
        "-u",
        "<target>",
        "-silent",
        "-json",
        "-title",
        "-tech-detect",
        "-status-code"
      ],
      "ruleIds": [
        "httpx_live_url"
      ],
      "payload_id": "httpx"
    }
  ],
  "targetType": [
    "web_url",
    "dvwa"
  ],
  "notSuitableFor": [],
