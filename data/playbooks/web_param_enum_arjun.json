{
  "id": "web_param_enum_arjun",
  "name": "Web Enum: Parameter Discovery (Arjun)",
  "description": "Uses Arjun to discover hidden HTTP GET and POST parameters. Useful before SQLi/XSS testing.",
  "tags": [
    "web",
    "enum",
    "arjun",
    "parameter",
    "recon"
  ],
  "estimatedMinutes": 3,
  "steps": [
    {
      "id": "step1_discover_get_params",
      "name": "Discover GET Parameters",
      "description": "Run Arjun to find hidden GET parameters. Uses chunk mode (-c 100) for speed.",
      "toolId": "arjun",
      "argsTemplate": [
        "-u",
        "<target>",
        "-m",
        "GET",
        "-c",
        "100",
        "-t",
        "10"
      ],
      "ruleIds": [
        "arjun_param_found"
      ],
      "score": 15,
      "payload_id": "arjun"
    },
    {
      "id": "step2_discover_post_params",
      "name": "Discover POST Parameters",
      "description": "Run Arjun to find hidden POST parameters for the same target.",
      "toolId": "arjun",
      "argsTemplate": [
        "-u",
        "<target>",
        "-m",
        "POST",
        "-c",
        "100",
        "-t",
        "10"
      ],
      "ruleIds": [
        "arjun_param_found"
      ],
      "score": 15,
      "payload_id": "arjun"
    }
  ],
  "targetType": [
    "web_url",
    "dvwa"
  ],
