{
  "id": "demo_web_full_killchain",
  "name": "Web 自动化杀伤链 (演示版)",
  "description": "DVWA 专用的自动化杀伤链演示。预检确认目标为 DVWA 后，依次执行端口与服务探测、指纹识别、目录枚举、已验证模板扫描和带 CSRF 会话的登录口令验证。",
  "target": "已确认的 DVWA 靶场",
  "rolesAllowed": [
    "viewer",
    "operator",
    "admin",
    "teacher",
    "student"
  ],
  "tags": [
    "web",
    "demo",
    "recon",
    "exploit",
    "brute_force",
    "dvwa"
  ],
  "steps": [
    {
      "id": "step_1_port_scan",
      "name": "精准端口与服务探测",
      "toolId": "nmap",
      "argsTemplate": [
        "-sV",
        "--open",
        "-Pn",
        "<target>"
      ],
      "description": "识别目标实际 HTTP 端口及内部真实中间件版本",
      "status": "PENDING",
      "score": 10,
      "payload_id": "port-scan",
      "expectedMitre": [
        "T1595",
        "T1046"
      ]
    },
    {
      "id": "step_2_fingerprint",
      "name": "Web 指纹深度识别",
      "toolId": "whatweb",
      "argsTemplate": [
        "-v",
        "<target>"
      ],
      "description": "提取 HTTP 头、PHP 版本等关键指纹证据",
      "status": "PENDING",
      "score": 15,
      "payload_id": "whatweb",
      "expectedMitre": [
        "T1592"
      ]
    },
    {
      "id": "step_3_dir_brute",
      "name": "敏感目录自动巡航",
      "toolId": "gobuster",
      "description": "并发爆破 Web 后台隐藏路径 (适配全版本 Gobuster)",
      "status": "PENDING",
      "score": 20,
      "payload_id": "gobuster",
      "expectedMitre": [
        "T1083"
      ],
      "argsTemplate": [
        "dir",
        "-u",
        "<target>",
        "-w",
        "config/wordlists/common_dirs.txt",
        "-t",
        "10"
      ]
    },
    {
      "id": "step_4_vuln_scan",
      "name": "Web 综合漏洞扫描",
      "toolId": "nuclei",
      "argsTemplate": [
        "-u",
        "<target>",
        "-id",
        "http-missing-security-headers,dvwa-default-login,phpinfo-files,phpmyadmin-panel"
      ],
      "description": "使用已在本地模板库中核验存在的 DVWA 与 Web 配置检测模板进行扫描",
      "status": "PENDING",
      "score": 25,
      "payload_id": "nuclei",
      "expectedMitre": [
        "T1190"
      ]
    },
    {
      "id": "step_5_brute_force",
      "name": "Grand Finale - DVWA 登录口令验证",
      "toolId": "web-brute",
      "argsTemplate": [
        "{{login_url}}",
        "-l",
        "admin",
        "-P",
        "config/wordlists/common_passwords.txt",
        "--csrf-field",
        "user_token",
        "--success-string",
        "Logout",
        "--threads",
        "2",
        "--max-time",
        "120"
      ],
      "description": "使用支持 CSRF 令牌与会话 Cookie 的表单验证工具对已确认的 DVWA 登录页执行受控口令验证。",
      "status": "PENDING",
      "score": 30,
      "payload_id": "auth-brute",
      "expectedMitre": [
        "T1110"
      ],
      "requiresTeacherReview": true
    }
  ],
  "rubric": {
    "items": [
      {
        "id": "http_service_found",
        "desc": "发现目标 HTTP 服务端口",
        "points": 10,
        "predicate": {
          "kind": "finding_type_min",
          "type": "open_port",
          "min": 1
        }
      },
      {
        "id": "web_fingerprint",
        "desc": "指纹识别成功",
        "points": 15,
        "predicate": {
          "kind": "finding_type_min",
          "type": "service_version",
          "min": 1
        }
      },
      {
        "id": "directory_found",
        "desc": "发现隐藏路径",
        "points": 20,
        "predicate": {
          "kind": "finding_type_min",
          "type": "web_path",
          "min": 1
        }
      },
      {
        "id": "template_scan_result",
        "desc": "已验证模板扫描产生结果",
        "points": 25,
        "predicate": {
          "kind": "finding_type_min",
          "type": "vulnerability",
          "min": 1
        }
      },
      {
        "id": "dvwa_login_verified",
        "desc": "成功验证 DVWA 登录凭据",
        "points": 30,
        "predicate": {
          "kind": "finding_type_min",
          "type": "compromised_credential",
          "min": 1
        }
      }
    ]
  },
  "targetType": [
    "dvwa"
  ],
  "notSuitableFor": [],
  "baselineGroup": "web-vuln-scan",
  "expectedOutputPolicy": "expect_output",
  "emptyOutputExplanation": "该演示仅适用于已由预检确认的 DVWA 靶场；通用 Web 目标请使用“Web 漏洞利用通用测试”。",
  "applicableTargetType": [
    "dvwa"
  ],
  "teachingObjective": "在确认 DVWA 产品特征后，演示从侦察、指纹识别和目录枚举，到模板扫描及带 CSRF 登录验证的完整 Web 杀伤链",
  "dvwa_profile": {
    "target_type": "dvwa",
    "host": "localhost",
    "port": 8080,
    "base_url": "http://localhost:8080",
    "login_url": "http://localhost:8080/login.php",
    "sqli_url": "http://localhost:8080/vulnerabilities/sqli/?id=1&Submit=Submit",
    "security_level": "low",
    "requires_cookie": false
  },
  "target_class": "dvwa"
}
