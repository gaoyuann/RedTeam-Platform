{
  "id": "vuln_nuclei",
  "name": "Nuclei 漏洞与配置缺陷检测",
  "description": "当 nuclei 输出包含 JSONL 命中结果（含 template-id、matched-at 等字段）时，命中对应 MITRE 技术",
  "when": {
    "toolId": "nuclei",
    "stdoutRegex": "(template-id|matched-at|matcher-name|http-missing-security-headers|CVE-|cve-|critical|high|medium|misconfiguration|exposure)"
  },
  "then": {
    "mitre": [
      {"id": "T1595.002", "name": "Vulnerability Scanning"},
      {"id": "T1592.002", "name": "Software - Gather Victim Host Information"},
      {"id": "T1190", "name": "Exploit Public-Facing Application"}
    ],
    "recommendations": [
      {
        "title": "对高危漏洞进行手动验证和 PoC 测试",
        "suggestedTool": "curl",
        "suggestedArgs": ["-v", "<target>"]
      },
      {
        "title": "对发现的配置缺陷进行深度扫描",
        "suggestedTool": "nikto",
        "suggestedArgs": ["-h", "<target>", "-maxtime", "60"]
      }
    ]
  }
}
