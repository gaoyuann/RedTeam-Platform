{
  "id": "web_server_nikto",
  "name": "Web 服务器漏洞与配置缺陷检测",
  "description": "当 nikto 输出包含安全头缺失、服务器版本泄露、危险文件或已知漏洞时，命中对应 MITRE 技术",
  "when": {
    "toolId": "nikto",
    "stdoutRegex": "(X-Frame-Options|X-Content-Type|clickjacking|Server:|x-powered-by|Retrieved|OSVDB|CVE-|item\\(s\\) reported|Uncommon header|No CGI|OPTIONS method)"
  },
  "then": {
    "mitre": [
      {"id": "T1592.002", "name": "Software - Gather Victim Host Information"},
      {"id": "T1595.002", "name": "Vulnerability Scanning"},
      {"id": "T1190", "name": "Exploit Public-Facing Application"}
    ],
    "recommendations": [
      {
        "title": "对发现的漏洞进行针对性 PoC 验证",
        "suggestedTool": "nuclei",
        "suggestedArgs": ["-u", "<target>", "-severity", "medium,high,critical"]
      },
      {
        "title": "对危险路径做深度目录枚举",
        "suggestedTool": "gobuster",
        "suggestedArgs": ["-u", "<target>", "-w", "config/wordlists/common_dirs.txt", "-t", "5"]
      }
    ]
  }
}
